# InstantDB
NEXT_PUBLIC_INSTANT_APP_ID=
INSTANT_ADMIN_TOKEN=

# Google Gemini (FREE — 1500 requests/day)
# Get your key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google OAuth (for authentication)
# Set up: https://www.instantdb.com/docs/auth/google-oauth
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=  # Bot username without @ (e.g., PanicAttackHelperBot)

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
